<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QPVBarcodeScannerApp.MainPage"
             Title="QPV Lector Código de Barras">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="QPV Logo" />

            <Label
                Text="Bienvenido a QPV Lector de Código de Barras"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"
                HorizontalOptions="Center"
                Margin="0,20,0,0" />

            <Label
                Text="Escanea códigos de barras para buscar productos en la base de datos o agregar nuevos productos."
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Descripción de la aplicación"
                HorizontalOptions="Center"
                Margin="0,0,0,20" />

            <Button
                x:Name="ScanButton"
                Text="Escanear Código de Barras"
                SemanticProperties.Hint="Inicia el escaneo de código de barras"
                Clicked="OnScanBarcodeClicked"
                HorizontalOptions="Fill"
                Margin="0,10" />

            <Button
                x:Name="ViewProductsButton"
                Text="Ver Productos"
                SemanticProperties.Hint="Ver lista de productos"
                Clicked="OnViewProductsClicked"
                HorizontalOptions="Fill"
                Margin="0,10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
